{
  "name": "la-riccia-tremiti",
  "version": "1.0.0",
  "private": true,
  "description": "La Riccia delle Tremiti — noleggio gommoni senza patente e tour guidati alle Isole Tremiti. Sito immersivo 3D.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c naviga/vite.config.ts",
    "preview": "vite preview",
    "naviga:test": "vitest run naviga/core",
    "naviga:typecheck": "tsc -p naviga/tsconfig.json",
    "naviga:osm": "node scripts/fetch-osm.ts",
    "naviga:zones": "node scripts/build-zones.ts && node scripts/check-poi.ts",
    "naviga:dev": "vite -c naviga/vite.config.ts",
    "naviga:build": "vite build -c naviga/vite.config.ts",
    "naviga:preview": "vite preview -c naviga/vite.config.ts",
    "naviga:demo-gpx": "node scripts/make-demo-gpx.ts",
    "naviga:e2e": "playwright test -c naviga/playwright.config.ts"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "@turf/bearing": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "maplibre-gl": "^6.16.0",
    "pmtiles": "^4.5.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@turf/area": "^7.4.0",
    "@turf/boolean-valid": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@turf/difference": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/kinks": "^7.4.0",
    "@turf/union": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
